          "charspan": [
            0,
            177
          ]
        }
      ],
      "orig": "\u00b7 Engineered a staged probabilistic-neural agentic pipeline , with a sequential NLU pipeline with confidence-gating , a DBN, and multiple ReAct agents for sequential generation.",
      "text": "Engineered a staged probabilistic-neural agentic pipeline , with a sequential NLU pipeline with confidence-gating , a DBN, and multiple ReAct agents for sequential generation.",
      "enumerated": false,
      "marker": "\u00b7"
